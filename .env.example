# Banco (SQLite no dev; em produção, uma URL postgresql://)
DATABASE_URL="file:./dev.db"

# Better Auth: segredo com 32+ caracteres (openssl rand -hex 32) e URL pública do app
BETTER_AUTH_SECRET="troque-por-um-segredo-longo"
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Cobrança. BILLING_MODE=fake usa o checkout/portal simulados (padrão do portfólio);
# os webhooks continuam assinados e verificados com o SDK oficial do Stripe.
BILLING_MODE="fake"
STRIPE_SECRET_KEY="sk_test_fake"
STRIPE_WEBHOOK_SECRET="whsec_troque-por-um-segredo"
STRIPE_PRICE_PRO="price_pro_mensal"
STRIPE_PRICE_BUSINESS="price_business_mensal"

# E-mails: sem chave, ficam na caixa de saída de dev (/dev/emails)
RESEND_API_KEY=""
EMAIL_FROM="Orçaí <nao-responda@orcai.dev>"

# E-mails (separados por vírgula) que veem o painel /admin de métricas
PLATFORM_ADMIN_EMAILS="admin@orcai.dev"

# Limite de tentativas de login/cadastro do Better Auth (deixe ligado; os E2E usam "off")
AUTH_RATE_LIMIT="on"
